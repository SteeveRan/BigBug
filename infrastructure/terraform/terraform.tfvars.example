# BigBug Infrastructure — Example Terraform Variables (config root: GitLab only, ADR-0033)
#
# Copy to terraform.tfvars and customize for your environment.
#
# IMPORTANT:
#   - gitlab_token must be a valid root PAT from GitLab.
#     For a fresh GitLab CE, get the initial root password:
#       docker compose -f infrastructure/docker-compose.yml exec gitlab cat /etc/gitlab/initial_root_password
#     Then create a PAT at https://gitlab.local:8443/-/user_settings/personal_access_tokens
#     with "api" scope. (init.sh also programs GITLAB_TOKEN from .env
#     automatically via gitlab-rails runner — ADR-0033.)
#
# Keycloak and Harbor configuration moved to the apps root
# (infrastructure/terraform/apps/) — all its variables have dev defaults in
# variables.tf; override via apps/terraform.tfvars if needed.

# ═══════════════════════════════════════════════════════════════════════════════
# GitLab
# ═══════════════════════════════════════════════════════════════════════════════

gitlab_url   = "https://gitlab.local:8443"
gitlab_token = "CHANGE-ME-root-personal-access-token"
# gitlab_ca_cert — path to the self-signed cert from kind/certs.sh
# (default ~/.local/state/bigbug/certs/gitlab.local/tls.crt — shared per
# machine, same dir as the tofu states; override or set "" only
# if you manage GitLab TLS differently).

mirrors_group_name = "bigbug-mirrors"

backend_user_name     = "BigBug Backend"
backend_user_username = "bigbug-backend"
backend_user_email    = "bigbug-backend@localhost.localdomain"
# backend_user_password — leave null to auto-generate via init.sh
# backend_user_password = null

# Backend PAT is NOT created by tofu — GitLab creds for the app are configured
# in the app UI (resource_providers) at app deploy time (ADR-0024, #56).
