/**
 * @file main.tf
 * @description keycloak_init module — Keycloak installation in ns `keycloak`
 *              (issue #57): namespace, TLS secret (ADR-0030), admin bootstrap
 *              secret, CNPG Postgres Cluster CR, keycloakx chart release.
 *              Realm/clients/roles/users config lives in ../keycloak_conf.
 *
 * Certs come from ../../../../../kind/certs (generated by certs.sh BEFORE
 * bootstrap; survive kind teardown — ADR-0030 §3).
 */

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    helm = {
      source  = "hashicorp/helm"
      version = "~> 2.16"
    }
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = "~> 2.35"
    }
  }
}

variable "certs_dir" {
  description = "Directory with per-host cert pairs (harbor.local/, keycloak.local/)"
  type        = string
}

variable "keycloak_hostname" {
  type    = string
  default = "keycloak.local"
}

variable "keycloak_admin_username" {
  type    = string
  default = "admin"
}

variable "keycloak_admin_password" {
  type      = string
  sensitive = true
}

variable "cnpg_storage_size" {
  type    = string
  default = "5Gi"
}
