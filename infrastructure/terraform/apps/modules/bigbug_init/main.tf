/**
 * @file main.tf
 * @description bigbug_init module — app infrastructure in ns `bigbug`
 *              (issue #59, ADR-0029): namespace, CNPG Postgres Cluster CR,
 *              Redis CR (redis-operator from base), app secrets (ADR-0024),
 *              TLS secrets + CA-bundle for the app chart (ADR-0030).
 *
 * The chart itself (charts/bigbug) is applied by helm, not here — this module
 * owns everything the chart consumes via secretKeyRef/configMapKeyRef.
 *
 * Certs come from ~/.local/state/bigbug/certs (generated by certs.sh BEFORE
 * bootstrap; shared per machine, survive worktree deletion and kind teardown —
 * ADR-0030 §3).
 */

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = "~> 2.35"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

variable "certs_dir" {
  description = "Directory with per-host cert pairs (api.local/, app.local/, keycloak.local/, harbor.local/)"
  type        = string
}

variable "cnpg_storage_size" {
  description = "CNPG cluster storage size (dev default)"
  type        = string
  default     = "5Gi"
}

variable "backend_client_id" {
  description = "OIDC client ID of the BigBug backend (created by ../keycloak_conf)"
  type        = string
  default     = "bigbug-backend"
}

variable "backend_client_secret" {
  description = "OIDC client secret of the BigBug backend"
  type        = string
  sensitive   = true
  default     = "bigbug-backend-secret"
}
