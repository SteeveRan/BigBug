/**
 * @file main.tf
 * @description harbor_init module — Harbor installation in ns `harbor`
 *              (issue #58): namespace, TLS secrets (ADR-0030 §5), goharbor
 *              chart release. Service configuration via API (projects,
 *              robots, OIDC auth) lives in ../harbor_conf.
 *
 * Certs come from ../../../../../kind/certs (generated by certs.sh BEFORE
 * bootstrap; survive kind teardown — ADR-0030 §3).
 */

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    helm = {
      source  = "hashicorp/helm"
      version = "~> 2.16"
    }
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = "~> 2.35"
    }
  }
}

variable "certs_dir" {
  description = "Directory with per-host cert pairs (harbor.local/, keycloak.local/)"
  type        = string
}

variable "harbor_chart_version" {
  description = "goharbor chart version (Renovate bumps)"
  type        = string
  default     = "1.19.4"
}
