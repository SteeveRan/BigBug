/**
 * @file harbor-tls.tf
 * @description TLS secrets for Harbor (ADR-0030 §5) — created from certs/
 *              files generated by ../../kind/certs.sh BEFORE bootstrap.
 *              Certs live outside the cluster lifecycle: they survive kind
 *              teardown and host trust does not need re-setup.
 *
 * - `tls-harbor-local` (ns harbor): harbor ingress TLS termination
 *   (expose.tls.certSource=secret).
 * - `harbor-ca-bundle` (ns harbor): keycloak.local cert as `ca.crt` — chart's
 *   caBundleSecretName mechanism mounts it into core/jobservice/registry trust
 *   stores, so Harbor core can call the Keycloak OIDC endpoint
 *   (https://keycloak.local) with oidc_verify_cert: true (ADR-0030 §4).
 */

locals {
  certs_dir = "${path.module}/../../kind/certs"
}

resource "kubernetes_secret_v1" "tls_harbor" {
  metadata {
    name      = "tls-harbor-local"
    namespace = kubernetes_namespace.harbor.metadata[0].name
  }

  type = "kubernetes.io/tls"

  data = {
    "tls.crt" = file("${local.certs_dir}/harbor.local/tls.crt")
    "tls.key" = file("${local.certs_dir}/harbor.local/tls.key")
  }
}

resource "kubernetes_secret_v1" "harbor_ca_bundle" {
  metadata {
    name      = "harbor-ca-bundle"
    namespace = kubernetes_namespace.harbor.metadata[0].name
  }

  # chart contract: exactly the `ca.crt` key
  data = {
    "ca.crt" = file("${local.certs_dir}/keycloak.local/tls.crt")
  }
}
