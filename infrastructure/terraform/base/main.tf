/**
 * @file main.tf
 * @description Base in-cluster entities for the bigbug-dev kind cluster (ADR-0024).
 *
 * Scope: platform layer only — ingress controller, operators, their CRDs.
 * App instances (Harbor, keycloakx, app chart) live in ../apps (separate state).
 *
 * Prerequisite: kind cluster `bigbug-dev` created by ../kind/bootstrap.sh
 * (cluster + /etc/hosts stay imperative per ADR-0024).
 */

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    helm = {
      source  = "hashicorp/helm"
      version = "~> 2.16"
    }
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = "~> 2.35"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

provider "kubernetes" {
  config_path    = var.kubeconfig_path
  config_context = var.kubeconfig_context
}

provider "helm" {
  kubernetes {
    config_path    = var.kubeconfig_path
    config_context = var.kubeconfig_context
  }
}

# ──────────────────────────────────────────────────────────────────────────────
# CNPG operator + Postgres cluster (ADR-0022 topology, issue #55)
#
#   operator  : helm chart cloudnative-pg (pinned), ns cnpg-system; the chart
#               installs the postgresql.cnpg.io CRDs
#   Cluster CR: kubernetes_manifest — needs the CRDs at PLAN time, so on a
#               fresh cluster the first apply is two-step:
#                 tofu apply -target=helm_release.cloudnative_pg   # CRDs
#                 tofu apply                                       # everything
#               Subsequent applies are plain `tofu apply` (idempotent).
#
# Secrets generated by the operator in ns `bigbug` (consumers: I3 tofu secrets,
# I6 helm chart):
#   bigbug-dev-app       — application user. Keys: user, password, host, port,
#                          dbname, uri, jdbc-uri, tls-uri. Connect to db
#                          `bigbug` or `keycloak` (owner of both).
#   Service for RW traffic: bigbug-dev-rw.bigbug.svc:5432
#
# Dev stand: single instance, no HA (ADR-0022). Deleting the cluster (kind
# teardown) drops all postgres data — acceptable for dev.
# ──────────────────────────────────────────────────────────────────────────────
resource "helm_release" "cloudnative_pg" {
  name             = "cloudnative-pg"
  repository       = "https://cloudnative-pg.github.io/charts"
  chart            = "cloudnative-pg"
  version          = "0.29.1" # operator 1.30.1, pinned
  namespace        = "cnpg-system"
  create_namespace = true
}

resource "kubernetes_namespace" "bigbug" {
  metadata { name = "bigbug" }
}

resource "kubernetes_manifest" "cnpg_cluster" {
  depends_on = [helm_release.cloudnative_pg, kubernetes_namespace.bigbug]

  manifest = {
    apiVersion = "postgresql.cnpg.io/v1"
    kind       = "Cluster"
    metadata = {
      name      = "bigbug-dev"
      namespace = "bigbug"
    }
    spec = {
      instances = 1
      bootstrap = {
        initdb = {
          database = "bigbug"
          owner    = "app"
          postInitSQL = [
            "CREATE DATABASE keycloak OWNER app",
          ]
        }
      }
      storage = {
        size = var.cnpg_storage_size
      }
      resources = {
        requests = {
          cpu    = "100m"
          memory = "256Mi"
        }
        limits = {
          memory = "512Mi"
        }
      }
    }
  }
}

# ──────────────────────────────────────────────────────────────────────────────
# Valkey — single-node cache for the app (ADR-0022: без operator в dev).
# Ephemeral storage (no PV) — cache data loss is acceptable on dev.
# Consumers connect to: valkey.bigbug.svc:6379 (no auth in dev)
# ──────────────────────────────────────────────────────────────────────────────
resource "kubernetes_deployment_v1" "valkey" {
  depends_on = [kubernetes_namespace.bigbug]

  metadata {
    name      = "valkey"
    namespace = "bigbug"
    labels    = { app = "valkey" }
  }

  spec {
    replicas = 1
    selector {
      match_labels = { app = "valkey" }
    }
    template {
      metadata {
        labels = { app = "valkey" }
      }
      spec {
        container {
          name  = "valkey"
          image = "valkey/valkey:8.1.10"
          port {
            container_port = 6379
          }
          readiness_probe {
            tcp_socket {
              port = 6379
            }
          }
          resources {
            requests = {
              cpu    = "50m"
              memory = "64Mi"
            }
            limits = {
              memory = "128Mi"
            }
          }
        }
      }
    }
  }
}

resource "kubernetes_service_v1" "valkey" {
  metadata {
    name      = "valkey"
    namespace = "bigbug"
  }
  spec {
    selector = {
      app = "valkey"
    }
    port {
      port        = 6379
      target_port = 6379
    }
  }
}

# ──────────────────────────────────────────────────────────────────────────────
# App secrets in k8s (ADR-0024, issue #56). Depends on the CNPG cluster (the
# operator's <cluster>-app secret is the credentials source) and the namespace.
# gitlab_token is passed through from tfvars (empty = secret not created).
# ──────────────────────────────────────────────────────────────────────────────
module "k8s_secrets" {
  source = "./modules/k8s-secrets"

  depends_on = [kubernetes_manifest.cnpg_cluster]

  # Literal: must match the Cluster spec above (manifest attr is unavailable
  # at refresh time — see kubernetes_manifest plan-time limitations).
  cnpg_app_secret_name = "bigbug-dev"
}
# ──────────────────────────────────────────────────────────────────────────────
# haproxy-ingress — cluster ingress controller (ingressClass default)
# host :80/:443 -> nodePort 30080/30443 via kind extraPortMappings
# ──────────────────────────────────────────────────────────────────────────────
resource "helm_release" "haproxy_ingress" {
  name             = "haproxy-ingress"
  repository       = "https://haproxytech.github.io/helm-charts"
  chart            = "kubernetes-ingress"
  namespace        = "haproxy-ingress"
  create_namespace = true

  set {
    name  = "controller.ingressClassResource.default"
    value = "true"
  }

  # Must match extraPortMappings in ../kind/kind-config.yaml
  set {
    name  = "controller.service.nodePorts.http"
    value = "30080"
  }
  set {
    name  = "controller.service.nodePorts.https"
    value = "30443"
  }
}
