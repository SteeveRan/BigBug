/**
 * @file cnpg.tf
 * @description CNPG operator + Postgres cluster (ADR-0022 topology, issue #55).
 *
 *   operator  : helm chart cloudnative-pg (pinned), ns cnpg-system; the chart
 *               installs the postgresql.cnpg.io CRDs
 *   Cluster CR: kubernetes_manifest — needs the CRDs at PLAN time, so on a
 *               fresh cluster the first apply is two-step:
 *                 tofu apply -target=helm_release.cloudnative_pg   # CRDs
 *                 tofu apply                                       # everything
 *               Subsequent applies are plain `tofu apply` (idempotent).
 *
 * Secrets generated by the operator in ns `bigbug` (consumers: I3 tofu secrets,
 * I6 helm chart):
 *   bigbug-dev-app       — application user. Keys: user, password, host, port,
 *                          dbname, uri, jdbc-uri, tls-uri. Connect to db
 *                          `bigbug` or `keycloak` (owner of both).
 *   Service for RW traffic: bigbug-dev-rw.bigbug.svc:5432
 *
 * Dev stand: single instance, no HA (ADR-0022). Deleting the cluster (kind
 * teardown) drops all postgres data — acceptable for dev.
 */

resource "helm_release" "cloudnative_pg" {
  name             = "cloudnative-pg"
  repository       = "https://cloudnative-pg.github.io/charts"
  chart            = "cloudnative-pg"
  version          = "0.29.1" # operator 1.30.1, pinned
  namespace        = "cnpg-system"
  create_namespace = true
}

resource "kubernetes_manifest" "cnpg_cluster" {
  depends_on = [helm_release.cloudnative_pg, kubernetes_namespace.bigbug]

  manifest = {
    apiVersion = "postgresql.cnpg.io/v1"
    kind       = "Cluster"
    metadata = {
      name      = "bigbug-dev"
      namespace = "bigbug"
    }
    spec = {
      instances = 1
      bootstrap = {
        initdb = {
          database = "bigbug"
          owner    = "app"
          postInitSQL = [
            "CREATE DATABASE keycloak OWNER app",
          ]
        }
      }
      storage = {
        size = var.cnpg_storage_size
      }
      resources = {
        requests = {
          cpu    = "100m"
          memory = "256Mi"
        }
        limits = {
          memory = "512Mi"
        }
      }
    }
  }
}
