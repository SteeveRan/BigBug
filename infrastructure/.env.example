# BigBug Infrastructure Environment Variables
# Copy to infrastructure/.env:
#   cp infrastructure/.env.example infrastructure/.env
#
# Used by infrastructure/docker-compose.yml

# =============================================================================
# Keycloak
# =============================================================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_POSTGRES_USER=keycloak
KC_POSTGRES_PASSWORD=keycloak
KC_POSTGRES_DB=keycloak

# =============================================================================
# GitLab
# =============================================================================
GITLAB_ROOT_PASSWORD=G!tLb_r0oT_9xQz#2
GITLAB_TOKEN=glpat-bigbug-backend-token

# =============================================================================
# GitLab CI/CD Components provisioning (infrastructure/provision-gitlab.sh)
# =============================================================================
# Base GitLab URL (host-side; the script uses http://localhost:8080 by default).
GITLAB_URL=http://localhost:8080

# GitLab runner authentication token (modern flow, GitLab 16.0+).
# Obtain one via `POST /api/v4/user/runners` or from Admin → CI/CD → Runners.
# If left empty, the script creates a new instance runner automatically
# (requires GITLAB_TOKEN with api scope).
GITLAB_RUNNER_AUTH_TOKEN=

# Runner container name as defined in docker-compose.yml.
GITLAB_RUNNER_CONTAINER=bigbug-gitlab-runner

# Runner metadata.
GITLAB_RUNNER_DESCRIPTION=bigbug-docker-runner
GITLAB_RUNNER_TAG_LIST=bigbug,docker

# Default job image for the docker executor (component jobs override with `image:`).
GITLAB_RUNNER_DOCKER_IMAGE=gcr.io/go-containerregistry/crane:debug

# GitLab group/project where the components live.
GITLAB_COMPONENTS_GROUP=bigbug-mirrors
GITLAB_COMPONENTS_PROJECT=components
GITLAB_COMPONENTS_DEFAULT_BRANCH=main

# Component tag (git tag) used by `include: component: ...@v1.0.0`.
# Must match the git tag exactly (GitLab component versions are exact tag matches).
GITLAB_COMPONENTS_TAG=v1.0.0

# NOTE: the consumer `.gitlab-ci.yml` references the component host via the
# GitLab predefined variable `$CI_SERVER_FQDN` (canonical form, resolves to
# `gitlab.local:8080`). No separate FQDN variable is required.

# Harbor hostname for `--docker-extra-hosts` and the target registry input.
GITLAB_HARBOR_HOST=harbor.local
