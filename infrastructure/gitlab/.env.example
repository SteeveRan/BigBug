# BigBug GitLab compose zone — environment variables (ADR-0033)
# Copy to infrastructure/gitlab/.env:
#   cp infrastructure/gitlab/.env.example infrastructure/gitlab/.env
#
# Used by infrastructure/gitlab/docker-compose.yml

# =============================================================================
# GitLab
# =============================================================================
GITLAB_ROOT_PASSWORD=G!tLb_r0oT_9xQz#2
GITLAB_TOKEN=glpat-bigbug-backend-token

# NOTE: GitLab is a compose service with TLS (https://gitlab.local:8443 —
# ADR-0030 §9; certs from kind/certs.sh). Keycloak/Harbor run in the kind
# cluster `bigbug-dev` (ADR-0022/0029) and need no .env here. GitLab CI/CD
# components and pipelines are provisioned by the application itself (via
# /api/gitlab-projects and /api/components/presets); the runner container
# remains managed by infrastructure/gitlab/docker-compose.yml and is registered
# once via `docker exec` (see infrastructure/README.md).
