# GitLab OpenTofu/Terraform variables — example values
# Copy to terraform.tfvars and customize for your environment.
#
# IMPORTANT: gitlab_token must be a valid root PAT from your GitLab instance.
# For a fresh GitLab CE, retrieve the initial root password:
#   docker compose -f docker-compose.infra.yml exec gitlab cat /etc/gitlab/initial_root_password
#
# Then create a root PAT via UI (http://localhost:8080/-/user_settings/personal_access_tokens)
# with "api" scope, and paste it here.

gitlab_url             = "http://localhost:8080"
gitlab_token           = "CHANGE-ME-root-personal-access-token"
mirrors_group_name     = "bigbug-mirrors"
backend_token_name     = "bigbug-backend-token"
backend_token_expires_at = "2027-12-31"

# Scopes required by backend for repo creation, mirroring, and CI/CD triggers
# backend_token_scopes = ["api", "read_repository", "write_repository"]
