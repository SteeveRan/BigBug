# Harbor OpenTofu/Terraform variables — example values
# Copy to terraform.tfvars and customize for your environment.
#
# IMPORTANT: harbor_password must be the admin password configured
# in harbor-values.yaml (default: Harbor12345).
#
# oidc_client_secret must match harbor_client_secret from the Keycloak
# OpenTofu config (infrastructure/keycloak/terraform.tfvars).
# The harbor OIDC client is created automatically by Keycloak OpenTofu.
#
# See: ../setup/keycloak-integration.md for detailed instructions.

# ─── Harbor Connection ───────────────────────────────────────────────────────
harbor_url      = "https://harbor.local"
harbor_username = "admin"
harbor_password = "Harbor12345"

# ─── OIDC / Keycloak Integration ─────────────────────────────────────────────
auth_mode           = "oidc_auth"
oidc_provider_name  = "Keycloak"
oidc_endpoint       = "http://localhost:8180/realms/bigbug"
oidc_client_id      = "harbor"
oidc_client_secret  = "CHANGE-ME-harbor-oidc-secret"
oidc_groups_claim   = "groups"
oidc_scope          = "openid,profile,email,groups"
oidc_verify_cert    = false
oidc_auto_onboard   = true
oidc_user_claim     = "preferred_username"

# ─── Projects ────────────────────────────────────────────────────────────────
gold_images_project_name  = "gold-images"
gold_images_storage_quota = -1

app_images_project_name   = "app-images"
app_images_storage_quota  = -1

mirrors_project_name      = "mirrors"
mirrors_storage_quota     = -1

# ─── Replication ─────────────────────────────────────────────────────────────
replication_schedule     = "0 0 2 * * *"
dockerhub_registry_name  = "docker-hub"
dockerhub_endpoint_url   = "https://hub.docker.com"
quay_registry_name       = "quay-io"
quay_endpoint_url        = "https://quay.io"

# ─── Webhooks ────────────────────────────────────────────────────────────────
webhook_backend_url = "http://localhost:8000/api/webhooks/harbor"
