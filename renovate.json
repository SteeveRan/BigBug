{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "matchUpdateTypes": ["major"],
      "groupName": "major dependencies (ADR review required)",
      "groupSlug": "all-major",
      "automerge": false,
      "labels": ["major:adr-review"],
      "prBodyNotes": [
        "⚠️ **Major update**: если компонент зафиксирован в ADR-реестре (`docs/adr/README.md`), перед мержем нужен новый/обновлённый ADR."
      ]
    },
    {
      "description": "Инфраструктурные версии, зафиксированные в ADR (ADR-0001/0002/0006): major-обновления блокированы до явного решения (новый ADR)",
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchPackageNames": ["python", "node", "postgres", "redis"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "python": {
    "enabled": true
  },
  "npm": {
    "enabled": true
  },
  "ignoreDeps": [],
  "schedule": ["before 5am on Monday"],
  "timezone": "Europe/Moscow",
  "prConcurrentLimit": 5
}
