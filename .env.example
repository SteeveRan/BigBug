# PostgreSQL
POSTGRES_USER=bigbug
POSTGRES_PASSWORD=bigbug
POSTGRES_DB=bigbug

# Redis
REDIS_URL=redis://redis:6379/0

# Backend
SECRET_KEY=changeme-in-production-use-openssl-rand-hex-32
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=bigbug
KEYCLOAK_CLIENT_ID=bigbug-backend
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_CLIENT_ID_FRONTEND=bigbug-frontend

# GitLab
GITLAB_URL=http://gitlab.local:8080
GITLAB_TOKEN=
GITLAB_ROOT_PASSWORD=GitLabRoot123!

# GitHub
GITHUB_TOKEN=

# Default build/sync schedule (cron)
DEFAULT_SYNC_CRON=0 2 * * *
DEFAULT_BUILD_CRON=0 3 * * 0

# Stale threshold (days)
DEFAULT_STALE_THRESHOLD_DAYS=30
