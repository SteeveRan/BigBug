# BigBug Application Environment Variables
# Copy to .env:
#   cp .env.example .env
#
# Used by docker-compose.yml (application services)

# =============================================================================
# PostgreSQL (backend database)
# =============================================================================
POSTGRES_USER=bigbug
POSTGRES_PASSWORD=bigbug
POSTGRES_DB=bigbug

# =============================================================================
# Backend API
# =============================================================================
SECRET_KEY=changeme-in-production
ENCRYPTION_KEY=
ENVIRONMENT=development
DB_WAIT_TIMEOUT=60

# =============================================================================
# Rate limiting (production only)
# =============================================================================
# Лимитер нужен только на продакшене. На dev/test стендах отключаем его,
# чтобы e2e-тесты и локальная отладка не упирались в лимиты логина.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_OIDC_EXCHANGE=3/minute
RATE_LIMIT_GLOBAL=1000/minute

# =============================================================================
# Initial admin user (created automatically on first start if none exists)
# =============================================================================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@bigbug.local
ADMIN_PASSWORD=admin
