# =============================================================
# BigBug environment configuration (example)
# Copy to `.env` and adjust values for your local setup.
# Never commit real secrets to git.
# =============================================================

# --- PostgreSQL: backend ----------------------------------------------------
# Used by the FastAPI backend (Alembic-managed schema).
POSTGRES_USER=bigbug
POSTGRES_PASSWORD=bigbug
POSTGRES_DB=bigbug

# --- PostgreSQL: Keycloak ---------------------------------------------------
# Keycloak gets its own database to keep schema ownership clean and allow
# independent backups/migrations from the backend DB.
KC_POSTGRES_USER=keycloak
KC_POSTGRES_PASSWORD=keycloak
KC_POSTGRES_DB=keycloak

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Backend ----------------------------------------------------------------
# PostgreSQL connection for the backend (used when running outside Docker).
# Inside Docker, docker-compose.app.yml overrides this to use postgres-backend:5432.
DATABASE_URL=postgresql+asyncpg://bigbug:bigbug@localhost:5432/bigbug

# Keycloak base URL for backend server-to-server OIDC communication.
# Inside Docker, docker-compose.app.yml overrides this to use keycloak:8180.
KEYCLOAK_URL=http://localhost:8180

# Keycloak public URL accessible from the browser (used by frontend for SSO redirect).
# The backend exposes this via /api/auth/sso/config so the browser can redirect to Keycloak.
# Should be publicly accessible from the user's browser.
KEYCLOAK_PUBLIC_URL=http://localhost:8180

# SECRET_KEY signs locally-issued JWTs (login/refresh tokens). Generate with:
#   openssl rand -hex 32
SECRET_KEY=changeme-in-production-use-openssl-rand-hex-32

# ENCRYPTION_KEY protects credentials at rest (Helm/Docker registry passwords)
# using Fernet (AES-128 + HMAC-SHA256). Must be a URL-safe base64 32-byte key.
# ⚠️  When left empty, Helm/Docker sync features will fail at runtime with a
#     clear error. Generate with:
#       python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Seconds the backend entrypoint waits for PostgreSQL before failing.
DB_WAIT_TIMEOUT=60

# --- Keycloak (admin & realm) ----------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=bigbug

# Confidential client used by the backend OIDC code-exchange endpoint.
KEYCLOAK_CLIENT_ID=bigbug-backend
KEYCLOAK_CLIENT_SECRET=bigbug-backend-secret

# Public client used by the SPA (Authorization Code + PKCE S256).
# Variable name matches docker-compose.yml: KEYCLOAK_CLIENT_ID_FRONTEND.
KEYCLOAK_CLIENT_ID_FRONTEND=bigbug-frontend
# Comma-separated lists consumed by keycloak/init-keycloak.sh.
KEYCLOAK_FRONTEND_REDIRECT_URIS=http://localhost:5173/*
KEYCLOAK_FRONTEND_WEB_ORIGINS=+

# Test user provisioned by `docker compose --profile init up keycloak-init`.
KC_TEST_USER=bigbug
KC_TEST_PASSWORD=bigbug
KC_TEST_EMAIL=bigbug@example.com
KC_TEST_ROLE=admin

# --- GitLab -----------------------------------------------------------------
GITLAB_URL=http://gitlab.local:8080
GITLAB_TOKEN=
GITLAB_ROOT_PASSWORD=BigBugGitLab2024!Secure

# --- GitHub -----------------------------------------------------------------
GITHUB_TOKEN=

# --- Harbor (local OCI registry deployed via harbor/deploy.sh) -------------
# Harbor HTTP endpoint (NodePort 30080 mapped to host port 80 via kind).
# Inside the Docker network, use harbor.local:30080 (added to /etc/hosts).
HARBOR_URL=http://harbor.local:30080
HARBOR_ADMIN_USER=admin
HARBOR_ADMIN_PASSWORD=Harbor12345

# --- Defaults / schedules --------------------------------------------------
# Default build/sync cron expressions (legacy mirrors/build features).
DEFAULT_SYNC_CRON=0 2 * * *
DEFAULT_BUILD_CRON=0 3 * * 0

# Stale-image threshold (days) used by housekeeping endpoints.
DEFAULT_STALE_THRESHOLD_DAYS=30
